      #endif

      #define INTERFACE_LOCATION(Pos) layout(location=Pos)
      #define INTERFACE_BLOCK(Pos, Interp, Modifiers, Semantic, PreType, PostType) layout(location=Pos) Modifiers Semantic { PreType PostType; }
        
      precision highp float;
      precision highp int;
        
      INTERFACE_BLOCK(3, noperspective , in , TEXCOORD0, highp vec2, Data) in_TEXCOORD0;
      INTERFACE_LOCATION(0) out vec4 out_Target0;
      uniform highp sampler2D ps1;
		
	  uniform vec4 rubedo;
      uniform vec4 pandora;
      uniform float uDepth;

      void main()
      {
          vec2 st = in_TEXCOORD0.Data.xy;
          vec2 uv = vec2(st.x * 30.0, st.y * 18.0);
          uv.y *= 1.7320508;

          vec2 s = vec2(1.7320508, 1.0);
          vec4 hc = floor(vec4(uv, uv - vec2(0.5, 0.5)) / s.xyxy);
          vec4 a = vec4(uv - (hc.xy + 0.5) * s, uv - (hc.zw + 1.0) * s);
          vec2 gv = dot(a.xy, a.xy) < dot(a.zw, a.zw) ? a.xy : a.zw;
        
          float x = abs(gv.x);
          float y = abs(gv.y);
          float d = max(x * 0.5 + y * 0.8660254, y);
          float mask = smoothstep(0.42, 0.45, d);
          if (mask > 0.0)
          {
              gl_FragDepth = uDepth;
              out_Target0 = pandora;
          }else{
              gl_FragDepth = gl_FragCoord.z;
              out_Target0 = rubedo;
          }
      }
