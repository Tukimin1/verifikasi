#version 310 es
      //MTeaR
      #define UE_EXT_shader_framebuffer_fetch 1

      #ifdef GL_EXT_gpu_shader5
      #extension GL_EXT_gpu_shader5 : enable
      #endif

      #extension GL_ARM_shader_framebuffer_fetch_depth_stencil : require
      #extension GL_OES_sample_variables : enable
      #extension GL_EXT_conservative_depth : enable

      #ifdef GL_EXT_conservative_depth
      layout(depth_any) out float gl_FragDepth;
      #endif

      #ifdef GL_EXT_texture_buffer
      #extension GL_EXT_texture_buffer : enable
      #endif

      #ifdef GL_EXT_texture_cube_map_array
      #extension GL_EXT_texture_cube_map_array : enable
      #endif

      #ifdef GL_EXT_shader_io_blocks
      #extension GL_EXT_shader_io_blocks : enable
      #endif

      #define INTERFACE_LOCATION(Pos) layout(location=Pos)

      #define INTERFACE_BLOCK(Pos, Interp, Modifiers, Semantic, PreType, PostType) 
      layout(location=Pos) Modifiers Semantic { PreType PostType; }

      INTERFACE_BLOCK(0, smooth, in, TEXCOORD10, highp vec4, Data) in_TEXCOORD10;
      INTERFACE_BLOCK(1, smooth, in, TEXCOORD11, highp vec4, Data) in_TEXCOORD11;
      INTERFACE_BLOCK(3, smooth, in, TEXCOORD0,  highp vec2, Data) in_TEXCOORD0;
      INTERFACE_BLOCK(5, smooth, in, TEXCOORD8,  highp vec4, Data) in_TEXCOORD8;

      precision mediump float;
      precision mediump int;

      uniform highp sampler2D ps0;
      uniform vec4 rubedo;
      uniform vec4 pandora;
      uniform float uDepth;

      INTERFACE_LOCATION(0) out vec4 out_Target0;

      void main()
      {

          vec3 v4 = in_TEXCOORD10.Data.xyz;
          vec4 v6 = in_TEXCOORD11.Data;

          vec3 v11 = normalize(
              vec3(-0.01, -0.01, -0.01) * in_TEXCOORD8.Data.xyz
          );

          vec2 v13 = (texture(ps0, in_TEXCOORD0.Data).xy * 2.0) 
                   - vec2(1.0);

          vec4 v14;
          v14.xy = v13;
          v14.z  = sqrt(clamp(1.0 - dot(v13, v13), 0.0, 1.0));
          v14.w  = 1.0;

          vec3 v17 = (v6.xyz * v14.z)
                    + ((cross(v6.xyz, v4) * v6.w) * v14.y)
                    + (v4 * v14.x);

          vec3 v16 = normalize(v17);

          float Mask = pow(
              clamp(1.0 - abs(dot(v16, -v11)), 0.0, 1.0),
              2.0
          );

          Mask = smoothstep(0.05, 0.30, Mask);

          bool isSmokeWall = false;
	      #ifdef GL_ARM_shader_framebuffer_fetch_depth_stencil
	          float sceneDepth = gl_LastFragDepthARM;
	           if (gl_FragCoord.z <= gl_LastFragDepthARM){
	              isSmokeWall = true;
	          }
	      #else
	          int x = int(gl_FragCoord.x);
	          int y = int(gl_FragCoord.y);
	          if (((x ^ y) & 1) == 0) isSmokeWall = true;
	      #endif

          if (isSmokeWall)
          {
              out_Target0 = mix(rubedo, pandora, Mask);
              gl_FragDepth = mix(1.0, 1.0, Mask);
          }

          else
          {
              out_Target0 = mix(pandora, rubedo, Mask);
              gl_FragDepth = mix(gl_FragCoord.z, 1.0, Mask);
          }
      }

